{
    "$schema": "../../schema/jinks.json",
    "label": "JATS Publisher",
    "description": "A workspace for displaying, editing and annotating JATS documents.",
    "id": "https://e-editiones.org/apps/jats-publisher",
    "type": "blueprint",
    "version": "1.0.0",
    "depends": [
        "base10",
        "theme-base10",
        "demo-data",
        "modern-theme",
        "jats",
        "annotate",
        "jinntap",
        "upload",
        "ci"
    ],
    "skipSource": [
        "repo.xml",
        "expath-pkg.xml",
        "build.xml"
    ],
    "defaults": {
        "data-default": "jats",
        "odd": "jats.odd",
        "browse": "jats-browse.html"
    },
    "features": {
        "upload": {
            "enabled": true,
            "target": "jats",
            "accept": ".xml, .tei, .odd, .docx, .md, .mei"
        },
        "jinntap": {
            "enabled": true
        }
    },
    "theme": {
        "fonts": {
            "base": {
                "family": "'Albert Sans', sans-serif"
            },
            "content": {
                "family": "'JunicodeVF', Georgia, 'Times New Roman', serif",
                "size": "1.2rem",
                "line-height": "1.6"
            },
            "heading": {
                "family": "'JunicodeVF', Georgia, 'Times New Roman', serif",
                "weight": "600"
            }
        },
        "content": {
            "max-width": "64ch"
        },
        "colors": {
            "palette": "academic",
            "palettes": {
                "academic": "palette-academic.css"
            }
        },
        "logo": {
            "image": "../images/jats-publisher-logo-contrast-color.svg"
        }
    },
    "styles": [
        "resources/css/jats-publisher.css"
    ]
}