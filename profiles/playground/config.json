{
    "$schema": "../../schema/jinks.json",
    "type": "feature",
    "category": "workflow",
    "id": "https://e-editiones.org/app/tei-publisher/playground",
    "label": "Playground",
    "description": "Adds ODD selection, ODD management, and experiment prompts to the browse view",
    "version": "1.0.0",
    "order": 100,
    "depends": [
        "base10"
    ],
    "features": {
        "playground": {
            "enabled": true
        }
    },
    "generator": {
        "templates": {
            "config-odd-available": "xmldb:get-child-resources($config:odd-root)[ends-with(., '.odd')][not(. = ('teipublisher_odds.odd', 'teilite.odd'))]"
        }
    },
    "templating": {
        "use": [
            "templates/playground-blocks.html"
        ]
    }
}
